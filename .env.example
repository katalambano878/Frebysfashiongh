# Copy to .env.local and fill in values (never commit .env.local)

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- AI (Support Copilot) ---
# Optional: if unset, support AI falls back to local heuristic drafting.
OPENAI_API_KEY=

# --- App URLs (used for payment callbacks & redirects) ---
APP_BASE_URL=http://localhost:3000
# Optional: public site URL if different from APP_BASE_URL (e.g. Vercel preview)
NEXT_PUBLIC_APP_URL=

# --- Moolre ---
MOOLRE_API_KEY=
MOOLRE_SECRET=
# Payment link/status API credentials
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
# Merchant payout/account details for payment links
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_MERCHANT_EMAIL=
# SMS
MOOLRE_SMS_API_KEY=
SMS_SENDER_ID=FrebysGH
# Optional: callback secret validation
MOOLRE_CALLBACK_SECRET=
# Optional: merchant / account identifiers if required by your Moolre integration
MOOLRE_MERCHANT_ID=
MOOLRE_BASE_URL=
# Optional: verify incoming webhooks
MOOLRE_WEBHOOK_SECRET=

# --- Notifications / Cron ---
EMAIL_FROM=
ADMIN_EMAIL=
CRON_SECRET=

# --- Paystack ---
# Server: Dashboard → Settings → API Keys & Webhooks → Secret key
PAYSTACK_SECRET_KEY=
# Client: same page → Public key (needed for Paystack Inline / JS on the browser)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Optional: Dashboard → Settings → Webhooks → signing secret (verify webhook payloads)
PAYSTACK_WEBHOOK_SECRET=

# --- Flutterwave ---
# Server: Dashboard → Settings → API keys → Secret key
FLUTTERWAVE_SECRET_KEY=
# Client: same → Public key
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
# Dashboard → Settings → API keys → Encryption key (required for some flows)
FLUTTERWAVE_ENCRYPTION_KEY=
# Webhook: use secret hash from Flutterwave dashboard to verify callbacks
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
